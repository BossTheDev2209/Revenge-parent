-- _Demo — ตัวอย่างครบทุกฟีเจอร์ของ dialogue engine (ก๊อปไปใช้ได้เลย)
-- คู่มือเต็ม: docs/engines/dialogue.md · ไฟล์นี้ = ของจริงเทสได้ กด Interact_NPC ที่ผูก _Demo
--
-- ========================================================================
-- ไฟล์บท 1 NPC return ได้ 2 ทรง:
--   ทรง A (บทเดี่ยว)      return { บรรทัด, บรรทัด, ... }
--   ทรง B (แยกตามเฟส)    return { p1 = {...}, p2 = {...}, p3 = {...}, after = {...} }
-- ระบบเลือกให้เอง: อยู่เฟสไหนใช้ pN ของเฟสนั้น ไม่มีก็ถอยลงหาอันใกล้สุด · ทรยศแล้วใช้ after ก่อน
-- ไฟล์นี้โชว์ทรง B (world NPC ส่วนใหญ่ใช้ทรง A บทเดี่ยวก็พอ)
-- ========================================================================

return {
	-- ===== เฟส 1 : โชว์ 1 บรรทัด 3 แบบ + tag ความเร็ว =====
	p1 = {
		-- 1) ข้อความล้วน (ไม่มีชื่อคนพูด)
		"เฮ้ย มานั่งตรงนี้สิ",

		-- 2) มีชื่อคนพูด (ขึ้นมุมซ้ายบนกล่อง)
		{ speaker = "ลุงสืบ", text = "ลุงเห็นเอ็งถ่ายคลิปทุกวันเลยนะ" },

		-- 3) tag คุมความเร็วพิมพ์กลางประโยค: [slow] ช้า / [fast] เร็ว / [normal] กลับปกติ
		{ speaker = "ลุงสืบ", text = "สู้ๆ นะ [slow]อย่ายอมแพ้ง่ายๆ [normal]ล่ะ" },
	},

	-- ===== เฟส 2 : โชว์ท่าทาง + สีหน้า (Genshin ref) =====
	p2 = {
		-- anim = ท่าเล่นครั้งเดียว · face = สีหน้า (ค้างจนสั่งใหม่/จบบท)
		{ speaker = "ลุงสืบ", text = "โห ดังขึ้นเยอะเลยนี่", anim = "Wave", face = "Happy" },
		-- pose = ท่ายืนค้าง (loop) · actor = ให้ "ตัวอื่น" ขยับแทนคนพูด
		{ speaker = "ลุงสืบ", text = "เดี๋ยวลุงเรียกป้ามาดูด้วย", actor = "ป้าไหม", anim = "Point" },
		-- บรรทัดสั่งท่า/หน้าล้วน (ไม่มี text) = ไม่ขึ้นกล่องข้อความ
		{ face = "Normal" },
	},

	-- ===== เฟส 3 : โชว์ช้อย (บาง NPC มีช้อย — ไม่ branching บรรจบเส้นเดิม) =====
	p3 = {
		{ speaker = "ลุงสืบ", text = "เป็นไงบ้าง เหนื่อยมั้ย?" },
		{
			choices = {
				-- tone = plus ⊕ / neutral ◎ / minus ⊖ (แค่ป้ายกำกับ ไม่มีผลต่อ mental)
				-- reply = บทตอบกลับหลังเลือก แล้วเล่นบรรทัดถัดไปต่อ (ทุกช้อยไปทางเดียวกัน)
				{ text = "เหนื่อยครับ", tone = "minus", reply = { { speaker = "ลุงสืบ", text = "พักบ้างนะ" } } },
				{ text = "ไหวอยู่!", tone = "plus", reply = { { speaker = "ลุงสืบ", text = "ดีๆ" } } },
				{ text = "...", tone = "neutral" }, -- ไม่มี reply = เลือกแล้วไปต่อเลย
			},
		},
		"แล้วเจอกันใหม่นะ", -- บรรทัดนี้เล่นเสมอ ไม่ว่าเลือกช้อยไหน
	},

	-- ===== after : บทหลังเพื่อนทรยศ (follower ≥ 500K) — มีเฉพาะ NPC ที่เกี่ยวกับ arc =====
	after = {
		{ speaker = "ลุงสืบ", text = "ได้ยินว่าเพื่อนเอ็งไปแล้วเหรอ... เสียใจด้วยนะ", face = "Sad" },
	},
}
