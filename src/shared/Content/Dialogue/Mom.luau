-- Mom — บทแม่ · ตัวอย่าง [placeholder] ที่โชว์ "ทุกฟีเจอร์" ของ dialogue engine
-- คู่มือเต็ม: docs/engines/dialogue.md · เทสจริงได้: กด NPC แม่ (Interact_NPC_แม่) ในเกม
-- ⚠️ เนื้อหาข้างล่างเป็น placeholder — ทีมเขียนบทจริงแทนได้เลย แก้แค่ข้อความในเครื่องหมายคำพูด
--    (ห้ามลบ comma / วงเล็บ — ไฟล์จะพัง · ห้ามพิมพ์คำว่า placeholder ในสตริงจริง เทสจะ FAIL)
--
-- ทรง B (แยกตามเฟส): ระบบเลือก pN ตามเฟสให้เอง · ไม่มี pN ของเฟสนั้น = ถอยลงหาอันใกล้สุด
--   ทรยศแล้ว (follower ≥ 500K) = ใช้ after ก่อนทุกเฟส
return {
	-- ═══════════════════════════════════════════════════════════════════
	-- เฟส 1 — 1 บรรทัดเขียนได้ 3 แบบ + tag คุมความเร็วพิมพ์
	-- ═══════════════════════════════════════════════════════════════════
	p1 = {
		-- แบบที่ 1) ข้อความล้วน — ไม่มีชื่อคนพูด (nameLabel ไม่ขึ้น)
		"ห้องนี้มันแคบไปไหมลูก...",

		-- แบบที่ 2) มีชื่อคนพูด — speaker ขึ้นมุมซ้ายบนกล่อง
		{ speaker = "แม่", text = "กลับมาทำไม ไม่มีเงินใช่ไหมล่ะ" },

		-- แบบที่ 3) tag คุมความเร็วกลางประโยค: [slow] 0.08 / [fast] 0.012 / [normal] 0.03 วิ/ตัว
		{ speaker = "แม่", text = "แม่ถามจริงๆ [slow]ลูกจะเอายังไงกับชีวิต [normal]กันแน่?" },
	},

	-- ═══════════════════════════════════════════════════════════════════
	-- เฟส 2 — ท่าทาง / สีหน้า / actor (Genshin ref)
	--   ไม่ใส่ field พวกนี้ = ตัวละครยืนเฉย · ใส่ผิด/ไม่มีไฟล์ = warn แล้วบทเล่นต่อ
	-- ═══════════════════════════════════════════════════════════════════
	p2 = {
		-- anim = ท่าเล่นครั้งเดียว (one-shot) · face = สีหน้า (ค้างจนสั่งใหม่/จบบท)
		{ speaker = "แม่", text = "อ้าว... กลับมาแล้วเหรอ", anim = "Wave", face = "Happy" },

		-- pose = ท่ายืนค้าง (loop) — ท่า loop เดิมของตัวนั้นถูกหยุดให้อัตโนมัติ
		{ speaker = "แม่", text = "มานั่งก่อนสิ แม่มีอะไรจะบอก", pose = "Sit", face = "Normal" },

		-- actor = ให้ "ตัวอื่น" ขยับแทนคนพูด (ต้องมีโมเดลตัวนั้นในแมพ)
		{ speaker = "แม่", text = "เดี๋ยวแม่เรียกพ่อมาด้วย", actor = "Dad", anim = "Point" },

		-- actor = "player" = สั่งตัวผู้เล่นขยับ (เช่นก้มหน้า)
		{ speaker = "แม่", text = "ทำไมไม่มองหน้าแม่ล่ะ", actor = "player", anim = "HeadScratch" },

		-- บรรทัดสั่งท่า/หน้าล้วน (ไม่มี text) = stage direction ไม่ขึ้นกล่องข้อความ
		{ face = "Sad", pose = "Idle" },
	},

	-- ═══════════════════════════════════════════════════════════════════
	-- เฟส 3 — ช้อย (มีได้แต่ห้าม branching — ทุกช้อยบรรจบเส้นเดิม, design doc §7)
	--   tone = plus ⊕ / neutral ◎ / minus ⊖ — แค่ป้ายกำกับ ไม่ผูก mental (ล็อก 28 ก.ค.)
	-- ═══════════════════════════════════════════════════════════════════
	p3 = {
		{ speaker = "แม่", text = "ลูกทำได้จริงๆ ด้วย... [slow]แม่ภูมิใจนะ", face = "Happy" },
		{
			choices = {
				-- ช้อยมี reply = พูดตอบกลับก่อน แล้วเล่นบรรทัดถัดไปต่อ
				{ text = "ขอบคุณที่ไม่ยอมแพ้กับผมนะแม่", tone = "plus",
					reply = { { speaker = "แม่", text = "แม่ต่างหากที่ต้องขอโทษ" } } },
				{ text = "ผมทำเพื่อพิสูจน์ให้แม่เห็น", tone = "minus",
					reply = { { speaker = "แม่", text = "แม่รู้แล้วลูก... แม่คิดผิดเอง" } } },
				-- ช้อยไม่มี reply = เลือกแล้วไปบรรทัดถัดไปเลย
				{ text = "...(ยิ้ม)", tone = "neutral" },
			},
		},
		-- บรรทัดนี้เล่นเสมอ ไม่ว่าเลือกช้อยไหน (= จุดบรรจบ)
		{ speaker = "แม่", text = "ไปกินข้าวกันเถอะ แม่ทำกับข้าวไว้" },
	},

	-- ═══════════════════════════════════════════════════════════════════
	-- after — บทหลังเพื่อนทรยศ (follower ≥ 500K) · ปกติมีเฉพาะ NPC ที่เกี่ยวกับ arc
	--   ใส่ให้ Mom ไว้เป็นตัวอย่างเฉยๆ — world NPC ทั่วไปไม่ต้องมี after
	-- ═══════════════════════════════════════════════════════════════════
	after = {
		{ speaker = "แม่", text = "ได้ข่าวว่าเพื่อนลูกไปแล้ว... [slow]กลับบ้านมาพักบ้างนะ", face = "Sad" },
	},
}
